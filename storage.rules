rules_version = '2';

// Invoice copies. Readable by any active dashboard user, uploadable by makers.
// KEEP companyDomain() IN SYNC with firestore.rules and src/config.ts.
service firebase.storage {
  match /b/{bucket}/o {
    function companyDomain() { return '.*@(mosaicwellness[.]in)$'; }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.token.email.lower())).data;
    }
    function isUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches(companyDomain())
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == 'microsoft.com')
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.token.email.lower()))
        && profile().active == true;
    }

    match /invoices/{invoiceId}/{fileName} {
      allow read: if isUser();
      allow create: if isUser()
        && profile().role == 'maker'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');
      allow update, delete: if false;   // replacements are uploaded as new files
    }
  }
}
