# Copy to .env.local for local development against Firebase.
# For GitHub Pages, add these as repository *Variables* (Settings → Secrets and variables → Actions → Variables).
VITE_APP_NAME=Invoice Payment Approvals
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# microsoft (Microsoft 365 / Entra ID) or google (Google Workspace)
VITE_SSO_PROVIDER=google
VITE_MICROSOFT_TENANT_ID=
# Google Workspace storage
# OAuth "Web client" ID (Google Cloud console → APIs & Services → Credentials)
VITE_GOOGLE_CLIENT_ID=
# Drive folder that holds the month folders (the ID at the end of the folder's URL)
VITE_DRIVE_FOLDER_ID=
# Google Sheet used as the live register (the ID in the sheet's URL)
VITE_SHEET_ID=
# Comma-separated company email domains
VITE_ALLOWED_DOMAINS=mosaicwellness.in
# Optional: finance team email(s); requires the Firebase "Trigger Email" extension
VITE_FINANCE_EMAIL=
