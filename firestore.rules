rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Server-side enforcement of: company-domain SSO, roles, and the approval chain
//   User 1 (maker) → L1 (approver1) → L2 (approver2)
//   → L3 (approver3) only if batch total > ₹20 lakh → Finance → Paid
//
// KEEP IN SYNC with src/config.ts:
//   • companyDomain()  ↔ allowedDomains
//   • threshold()      ↔ l3Threshold
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function companyDomain() { return '.*@(mosaicwellness[.]in)$'; }
    function threshold() { return 2000000; }                          // ₹20,00,000

    // ── Identity ────────────────────────────────────────────────────────────
    function email() { return request.auth.token.email.lower(); }
    function companyAccount() {
      return request.auth != null
        && request.auth.token.email is string
        && email().matches(companyDomain())
        // Google marks verified emails; Microsoft sign-ins are restricted by tenant.
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == 'microsoft.com');
    }
    function userPath() { return /databases/$(database)/documents/users/$(email()); }
    function isUser() { return companyAccount() && exists(userPath()) && get(userPath()).data.active == true; }
    function hasRole(r) { return isUser() && get(userPath()).data.role == r; }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function unchanged(keys) { return !changed().hasAny(keys); }

    // ── Users & roles (admin-managed; document id = lower-case email) ──────
    match /users/{userEmail} {
      allow get: if companyAccount() && userEmail == email();   // see own profile even before approval
      allow read: if isUser();
      allow create, update: if hasRole('admin')
        && userEmail == userEmail.lower()
        && userEmail.matches(companyDomain())
        && request.resource.data.keys().hasOnly(['name', 'role', 'active'])
        && request.resource.data.role in ['maker', 'approver1', 'approver2', 'approver3', 'finance', 'admin']
        && request.resource.data.active is bool
        // admins cannot demote or disable themselves (avoids lock-out)
        && (userEmail != email() || (request.resource.data.role == 'admin' && request.resource.data.active == true));
      allow delete: if hasRole('admin') && userEmail != email();
    }

    // ── Invoices (written only by User 1 / makers) ──────────────────────────
    // Invoice copies live in Google Drive (access managed by Drive sharing).
    function amountsOk(d) {
      return d.taxableAmount is number && d.gstAmount is number && d.totalAmount is number
        && d.taxableAmount >= 0 && d.gstAmount >= 0 && d.totalAmount > 0
        && math.abs(d.taxableAmount + d.gstAmount - d.totalAmount) <= 1
        && d.serviceMonth is string
        && d.serviceMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }
    function batchPath(id) { return /databases/$(database)/documents/batches/$(id); }
    // Editable unless it sits in a batch that is still in approval / paid.
    // A rejected batch, or an invoice an approver took out of its batch, is editable.
    function unlocked(inv, id) {
      return inv.batchId == null
        || !exists(batchPath(inv.batchId))
        || get(batchPath(inv.batchId)).data.status == 'REJECTED'
        || !(id in get(batchPath(inv.batchId)).data.invoiceIds);
    }

    match /invoices/{invoiceId} {
      allow read: if isUser();

      allow create: if hasRole('maker')
        && request.resource.data.createdBy == email()
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.batchId == null
        && request.resource.data.validatedBy == null
        && amountsOk(request.resource.data);

      // (a) edit or validate while not locked in an active batch
      allow update: if hasRole('maker')
        && unchanged(['createdBy', 'createdAt'])
        && unlocked(resource.data, invoiceId)
        && request.resource.data.batchId == null
        && amountsOk(request.resource.data)
        && (request.resource.data.status == 'DRAFT'
            || (request.resource.data.status == 'VALIDATED' && request.resource.data.validatedBy == email()));

      // (b) send for approval: attach a validated invoice to a batch. Only the
      //     person who validated it may do so, and nothing else may change.
      //     Deliberately needs no document lookups, so bulk sends stay within
      //     the rules' 20-lookups-per-write limit.
      allow update: if companyAccount()
        && resource.data.status == 'VALIDATED'
        && resource.data.batchId == null
        && resource.data.validatedBy == email()
        && request.resource.data.status == 'VALIDATED'
        && request.resource.data.batchId is string
        && changed().hasOnly(['batchId', 'updatedAt', 'history']);

      allow delete: if hasRole('maker') && resource.data.batchId == null;
    }

    // ── Payment batches (one per expense category per send) ─────────────────
    function lastApproval() { return request.resource.data.approvals[request.resource.data.approvals.size() - 1]; }

    // Approver at `level` moves a batch out of `from` to `to` (approve) or REJECTED.
    function decide(level, from, to) {
      return resource.data.status == from
        && changed().hasOnly(['status', 'approvals', 'updatedAt'])
        && request.resource.data.approvals.size() == resource.data.approvals.size() + 1
        && request.resource.data.approvals[0:resource.data.approvals.size()] == resource.data.approvals
        && lastApproval().by == email()
        && lastApproval().level == level
        && ((request.resource.data.status == to && lastApproval().decision == 'APPROVED')
            || (request.resource.data.status == 'REJECTED' && lastApproval().decision == 'REJECTED'
                && lastApproval().comment is string && lastApproval().comment.size() > 0));
    }

    // Approver at the batch's current level takes some invoices out and sends
    // them back to User 1. The batch keeps its level; totals and the >20 lakh
    // routing must match what is left.
    function returnSome(level, at) {
      return resource.data.status == at
        && request.resource.data.status == at
        && changed().hasOnly(['invoiceIds', 'invoiceCount', 'taxableTotal', 'gstTotal', 'totalAmount', 'requiresL3', 'returned', 'updatedAt'])
        && request.resource.data.invoiceIds.size() > 0
        && request.resource.data.invoiceIds.size() < resource.data.invoiceIds.size()
        && resource.data.invoiceIds.hasAll(request.resource.data.invoiceIds)
        && request.resource.data.invoiceCount == request.resource.data.invoiceIds.size()
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount > 0
        && request.resource.data.totalAmount < resource.data.totalAmount
        && request.resource.data.requiresL3 == (request.resource.data.totalAmount > threshold())
        && request.resource.data.returned.size() > resource.data.get('returned', []).size()
        && request.resource.data.returned[request.resource.data.returned.size() - 1].by == email()
        && request.resource.data.returned[request.resource.data.returned.size() - 1].level == level
        && request.resource.data.returned[request.resource.data.returned.size() - 1].reason.size() > 0;
    }

    function markPaid() {
      return resource.data.status == 'WITH_FINANCE'
        && request.resource.data.status == 'PAID'
        && changed().hasOnly(['status', 'paymentRef', 'paidAt', 'paidBy', 'updatedAt'])
        && request.resource.data.paidBy == email()
        && request.resource.data.paymentRef is string
        && request.resource.data.paymentRef.size() > 0;
    }

    function batchUpdate(role) {
      return (role == 'approver1' && (decide(1, 'PENDING_L1', 'PENDING_L2') || returnSome(1, 'PENDING_L1')))
        || (role == 'approver2' && (decide(2, 'PENDING_L2', resource.data.requiresL3 ? 'PENDING_L3' : 'WITH_FINANCE') || returnSome(2, 'PENDING_L2')))
        || (role == 'approver3' && (decide(3, 'PENDING_L3', 'WITH_FINANCE') || returnSome(3, 'PENDING_L3')))
        || (role == 'finance' && markPaid());
    }

    match /batches/{batchId} {
      allow read: if isUser();

      allow create: if hasRole('maker')
        && request.resource.data.createdBy == email()
        && request.resource.data.status == 'PENDING_L1'
        && request.resource.data.approvals.size() == 0
        && request.resource.data.invoiceIds.size() > 0
        && request.resource.data.invoiceIds.size() == request.resource.data.invoiceCount
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount > 0
        // the >₹20 lakh routing flag cannot be faked
        && request.resource.data.requiresL3 == (request.resource.data.totalAmount > threshold())
        && request.resource.data.paymentRef == null;

      // The user's role is read once here: each rule check may look up at
      // most 10 documents, so the role must not be re-read per branch.
      allow update: if isUser() && batchUpdate(get(userPath()).data.role);

      allow delete: if false;   // full audit trail is kept
    }

    // ── Vendor list (built-in names are in the app; added ones live here) ──
    // Document id = vendor name lower-cased with symbols removed, so the same
    // vendor can't be added twice.
    match /vendors/{vendorId} {
      allow read: if isUser();
      allow create: if isUser() && get(userPath()).data.role in ['maker', 'admin']
        && vendorId.matches('^[a-z0-9]{2,120}$')
        && request.resource.data.keys().hasOnly(['name', 'gstin', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
        && request.resource.data.gstin is string
        && request.resource.data.createdBy == email();
      allow update, delete: if hasRole('admin');
    }

    // ── Outgoing email (Firebase "Trigger Email" extension), optional ───────
    match /mail/{id} {
      allow create: if isUser() && get(userPath()).data.role in ['approver2', 'approver3'];
      allow read, update, delete: if false;
    }
  }
}
